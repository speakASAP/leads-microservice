datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id                        String                          @id @default(uuid())
  status                    String                          @default("new")
  // The auth-microservice user this lead was created from (EP-005 W5). Unique, because a person
  // registers once: brokers deliver at least once, and without this a redelivery would create a
  // second lead for the same human being.
  authUserId                String?                         @unique
  sourceService             String
  sourceUrl                 String?
  sourceLabel               String?
  message                   String                          @db.Text
  preferredChannel          String?
  fallbackChannels          Json?
  marketingConsent          Boolean?
  consentSource             String?
  consentCapturedAt         DateTime?
  unsubscribedAt            DateTime?
  confirmationToken         String?                         @unique
  confirmedAt               DateTime?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  contactMethods            LeadContactMethod[]
  submissions               LeadSubmission[]
  lifecycleEvents           LeadLifecycleEvent[]
  marketingApprovalEvidence LeadMarketingApprovalEvidence[]
  qualifications            LeadQualification[]

  @@index([createdAt])
  @@index([sourceService])
}

/// S6 — the owner's manual judgement about a lead (C-006 §1, D19).
///
/// Append-only. A correction is a NEW row naming the one it supersedes; nothing here is ever
/// updated or deleted, so "what did we think of this lead, and when" stays answerable.
///
/// There is no `pending` row. Pending is a lead with no rows here at all — recording it would turn
/// "not worked yet" into a decision, and the cost metric counts pending leads against spend
/// precisely because nobody decided anything about them.
model LeadQualification {
  id                          String   @id @default(uuid())
  leadId                      String
  /// `qualified` | `disqualified`. Not an enum: adding a value to a Prisma enum is a migration on
  /// a table that must never be rewritten, and the contract schema is what actually pins the set.
  qualificationStatus         String
  /// Pinned to `v1-owner-manual`. A later criteria revision is a new event version, so old
  /// judgements are never silently re-read under new rules.
  criteriaVersion             String
  /// Always `human` at v1. No rule-based or AI qualification exists.
  decidedByType               String
  /// The authenticated admin user id — never the literal string "owner".
  decidedById                 String
  decidedAt                   DateTime
  reason                      String   @db.Text
  supersedesQualificationId   String?
  /// Set once the event reached the broker. Null means the judgement is stored but growth-core
  /// has not heard about it — recoverable, and visible instead of silently lost.
  announcedAt                 DateTime?
  createdAt                   DateTime @default(now())
  lead                        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, decidedAt])
  @@index([decidedAt])
}

model LeadContactMethod {
  id        String   @id @default(uuid())
  leadId    String
  type      String
  value     String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadSubmission {
  id          String   @id @default(uuid())
  leadId      String
  payloadJson Json
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model LeadMarketingApprovalEvidence {
  id                            String   @id @default(uuid())
  leadId                        String
  idempotencyKey                String   @unique
  approvalId                    String
  campaignId                    String
  approvedAt                    DateTime
  purposeCode                   String
  channel                       String
  audienceCount                 Int
  eligibleCount                 Int
  retentionExpectation          String
  humanApprovalReferencePresent Boolean  @default(false)
  approvedByPresent             Boolean  @default(false)
  workspaceIdPresent            Boolean  @default(false)
  contentVersionPresent         Boolean  @default(false)
  eligibilityEligible           Boolean
  eligibilityReasons            Json?
  returnedContactMethodCount    Int      @default(0)
  recordedAt                    DateTime @default(now())
  lead                          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, recordedAt])
  @@index([approvalId])
  @@index([campaignId])
  @@index([recordedAt])
}

model LeadLifecycleEvent {
  id             String   @id @default(uuid())
  leadId         String
  eventId        String   @unique
  eventType      String
  eventVersion   Int
  occurredAt     DateTime
  producer       String
  correlationId  String?
  idempotencyKey String?  @unique
  dataClass      String
  payload        Json
  consumerRoutes Json?
  recordedAt     DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
  @@index([eventType])
  @@index([recordedAt])
}
